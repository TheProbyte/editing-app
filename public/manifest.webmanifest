{
  "name": "Lumen Photo Editor",
  "short_name": "Lumen",
  "description": "Photo and video editor for your phone — RAW, masks, lens blur, film grain, halation, curves, color and a timeline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0e0e0e",
  "theme_color": "#0e0e0e",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/*": [
          ".jpg",
          ".jpeg",
          ".png",
          ".heic",
          ".webp",
          ".dng",
          ".cr2",
          ".cr3",
          ".nef",
          ".arw",
          ".raf",
          ".orf",
          ".rw2"
        ],
        "video/*": [
          ".mp4",
          ".mov",
          ".m4v",
          ".webm",
          ".mkv",
          ".3gp"
        ]
      }
    }
  ],
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*",
            "video/*",
            ".dng",
            ".mov",
            ".mp4",
            ".webm"
          ]
        }
      ]
    }
  }
}
